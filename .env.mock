# 独立 mock 服务构建环境（pnpm build:mock → 前端 dist + .deploy/mock-server）

# 部署基础路径，与 nginx 里的访问路径一致；独立域名部署时改为 /
VITE_BASE_URL=/react/

# 接口前缀：同时决定前端请求前缀、mock 文件的 URL 前缀、mock 服务的拦截前缀，三者必须一致
VITE_APP_BASE_API=/react-mock-api

# 应用端口（构建期不需要，仅保持与其它 env 一致）
VITE_APP_PORT=4000

# 项目名称
VITE_APP_TITLE=react-antd-admin

# 接口地址（仅开发代理转发用，构建独立 mock 服务时不生效）
VITE_APP_API_URL=https://www.youlai.tech

# 开启 mock 插件
VITE_MOCK_ENABLED=true

# 产出独立 mock 服务：产物在 .deploy/mock-server
VITE_MOCK_BUILD=true

# 独立 mock 服务监听端口
VITE_MOCK_PORT=8083
