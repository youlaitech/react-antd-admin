{
  "name": "react-antd-admin",
  "description": "React19 + Vite + TypeScript + Ant Design 的后台管理模板",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-only": "vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:eslint": "eslint --cache src mock vite.config.ts uno.config.ts eslint.config.ts --fix",
    "lint:prettier": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,scss,css,json}\" \"mock/**/*.ts\" \"*.{ts,cjs,mjs,json,yaml,html}\" \".github/workflows/*.{yml,yaml}\"",
    "lint:stylelint": "stylelint --cache \"**/*.{css,scss}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:stylelint",
    "lint:check": "eslint src mock vite.config.ts uno.config.ts eslint.config.ts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,scss,css,json}\" \"mock/**/*.ts\" \"*.{ts,cjs,mjs,json,yaml,html}\" \".github/workflows/*.{yml,yaml}\"",
    "style:check": "stylelint \"src/**/*.{css,scss}\"",
    "check": "pnpm run type-check && pnpm run lint:check && pnpm run format:check && pnpm run style:check",
    "deploy": "node deploy.mjs",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@wangeditor-next/editor": "^5.7.16",
    "antd": "^6.6.7",
    "axios": "^1.20.0",
    "codemirror": "^5.65.21",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.5.3",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "qs": "^6.16.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify/utils": "^3.1.7",
    "@types/codemirror": "^5.60.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.5.1",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.104.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-order": "^8.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unocss": "^66.10.2",
    "vite": "^8.3.3",
    "vite-plugin-mock-dev-server": "2.4.2"
  },
  "engines": {
    "node": "^22.22.1 || >=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "follow-redirects": "^1.16.2",
      "source-map-js": "^1.2.2",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "minimatch": "^11.0.1",
      "glob@10": "^10.5.0",
      "fast-uri@3": "^3.1.9",
      "@modelcontextprotocol/server@2": "~2.3.0"
    }
  },
  "repository": "https://gitee.com/youlaiorg/react-antd-admin.git",
  "author": "有来开源组织",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5"
}
