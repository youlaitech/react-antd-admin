{
  "name": "react-antd-admin",
  "description": "React19 + Vite + TypeScript + Ant Design 的后台管理模板",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint:eslint": "eslint --cache \"src/**/*.{ts,tsx}\" --fix",
    "lint:prettier": "prettier --write \"**/*.{js,cjs,ts,tsx,json,css,scss,html,md}\"",
    "lint:stylelint": "stylelint --cache \"**/*.{css,scss}\" --fix",
    "lint:lint-staged": "lint-staged",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier && pnpm run lint:stylelint",
    "deploy": "node deploy.mjs",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{cjs,json}": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@wangeditor-next/editor": "^5.7.16",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "codemirror": "^5.65.21",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^26.4.2",
    "keepalive-for-react": "^6.0.0",
    "lodash-es": "^4.18.1",
    "nprogress": "^0.2.0",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@iconify/utils": "^3.1.7",
    "@types/codemirror": "^5.60.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.5.1",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unocss": "^66.10.2",
    "vite": "^8.3.0",
    "vite-plugin-mock-dev-server": "2.4.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": "https://gitee.com/youlaiorg/react-antd-admin.git",
  "author": "有来开源组织",
  "license": "MIT"
}
