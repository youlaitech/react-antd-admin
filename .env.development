# 应用端口（与 vue3-element-admin 的 3000 错开，便于两个项目同时启动）
VITE_APP_PORT=4000
# 项目名称
VITE_APP_TITLE=react-antd-admin
# 代理前缀
VITE_APP_BASE_API=/dev-api

# 本地 mock 开关：true 时 mock/ 目录接管已实现接口，直接可跑，无需后端；
# 关掉（false）后全部请求走下面的接口地址
VITE_MOCK_ENABLED=true

# 接口地址（mock 未覆盖的接口转发到这里）
VITE_APP_API_URL=https://api.youlai.tech     # 线上
# VITE_APP_API_URL=http://localhost:8000     # 本地
